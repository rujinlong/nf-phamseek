/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    phamseek — Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Software provisioning: Apptainer BY DEFAULT, from one multi-arch image on
    Docker Hub. `-profile docker`, `-profile pixi` and `-profile native` select
    the alternatives; each of them turns the others off explicitly, because
    Nextflow will happily have two engines enabled at once and then report the
    failure of whichever it tried second.

    There is exactly one image and exactly one solved environment behind all of
    them: docker/Dockerfile installs pixi.lock, so the container, the pixi route
    and the offline bundle cannot drift apart.

    Reference databases are never in the image and never in the work directory.
    They are passed with --db_dir and read in place.
----------------------------------------------------------------------------------------
*/

params {

    // ------------------------------------------------------------------
    // Input / output
    // ------------------------------------------------------------------
    input                       = null
    outdir                      = 'results'

    // Only the `fast` tier is implemented. `full` (assembly, geNomad, CheckV)
    // fails fast with an explicit message rather than running a partial path.
    mode                        = 'fast'

    // ------------------------------------------------------------------
    // Reference databases — always external, never bundled with the repo.
    // `db_dir` supplies the standard layout; the explicit paths below win when
    // set. Resolution happens at initialisation, because a params block cannot
    // reference other params (INV-NF-04).
    // ------------------------------------------------------------------
    db_dir                      = null
    kraken2_db                  = null
    host_index                  = null

    // Declared property of the kraken2 database. It cannot be auto-detected and
    // it changes how the false-positive caveat has to be worded in the report.
    // 'auto' (default) inspects the database's own taxonomy and reports each
    // decoy class separately. 'true'/'false' override that with an operator
    // declaration. A plain false default was actively harmful: the recommended
    // production database *does* carry decoy sequences, nobody remembers the
    // flag, and the report would then print the high-plasmid-false-positive
    // warning for a database where it does not apply.
    db_has_decoy                = 'auto'
    db_label                    = null
    // --mode setup only: which component to download.
    db_component                = 'all'

    // ------------------------------------------------------------------
    // Step toggles
    // ------------------------------------------------------------------
    skip_host_removal           = false   // skips the level-2 aligner only
    // Bracken's model assumes one fixed read length. ONT reads are variable
    // length, so the assumption is violated by construction -- off by default.
    // Enable it only with bracken_read_length set from your own run.
    //
    // Named for what it turns ON. The earlier `skip_bracken = true` meant that
    // enabling bracken read `--skip_bracken false`, a double negative that has
    // to be typed the long way round and that Groovy would silently read as
    // "true" if it were not routed through asBool(). `--run_bracken` is a bare
    // flag that cannot be typed backwards.
    run_bracken                 = false

    // ------------------------------------------------------------------
    // Long-read QC (chopper / nanoq)
    // ------------------------------------------------------------------
    chopper_min_quality         = 10
    chopper_min_length          = 200

    // ------------------------------------------------------------------
    // kraken2
    //
    // 0.02 rather than kraken2's default of 0: with a phage reference database
    // the default calls a taxon on a single k-mer hit, which made 61% of human
    // and 38% of clean bacterial contigs look like phage in the benchmark this
    // pipeline is derived from.
    //
    // Do NOT raise it for ONT. Short-read tuning intuition does not transfer:
    // 0.02 -> 0.10 costs ~3.5 points of recall on 150 bp reads at 0.1% error,
    // but 15 points at 95% read identity and 29 points at 87%, because a
    // high-error long read carries far fewer exactly-matching k-mers to vote
    // with. Raising it also cannot remove plasmid/ICE false positives, which
    // are real shared homology rather than stray k-mers.
    // ------------------------------------------------------------------
    kraken2_confidence          = 0.02

    // ------------------------------------------------------------------
    // Host depletion
    // ------------------------------------------------------------------
    host_taxid                  = 9606
    viral_taxid                 = 10239
    // 'all_nonhuman'        — everything not in the host subtree goes to level 2
    // 'nonhuman_nonviral'   — viral-classified reads bypass level 2 (faster,
    //                         but a human read misclassified as viral would
    //                         then escape host depletion)
    l2_input                    = 'all_nonhuman'
    minimap2_preset             = 'map-ont'

    // ------------------------------------------------------------------
    // bracken
    // ------------------------------------------------------------------
    // No safe default exists for ONT. 150 would be a short-read value; set this
    // from the median read length of your run before enabling bracken.
    bracken_read_length         = null
    bracken_level               = 'S'
    bracken_threshold           = 10

    // ------------------------------------------------------------------
    // Reporting thresholds
    // ------------------------------------------------------------------
    min_reads                   = 10
    min_rpm                     = 1.0

    // Krona charts. On by default: krona is noarch and 155 KiB, kreport2krona
    // ships with krakentools which is already a dependency, and the step reads
    // a file the pipeline has already written. `skip`, not `run`, because the
    // default is on -- a bare --skip_krona turns it off.
    skip_krona                  = false

    // ------------------------------------------------------------------
    // Generic
    // ------------------------------------------------------------------
    // `--help`, `--help <parameter>` and `--show_hidden` are rendered by the
    // pipeline itself from nextflow_schema.json, not by the schema plugin --
    // see the `validation` scope below for why.
    help                        = false
    show_hidden                 = false
    version                     = false
    monochrome_logs             = false
    validate_params             = true

    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
}


// ---------------------------------------------------------------------------
// Default provisioning: Apptainer, from the published multi-arch image.
//
// Declared OUTSIDE `profiles` on purpose. A `standard` profile would be dropped
// the moment anyone passes `-profile test`, which is exactly when a silent
// switch to "whatever is on PATH" is most damaging: the run would succeed and
// the versions in the report would be the host's.
// ---------------------------------------------------------------------------
// A closure, evaluated per task, so the tag is read from the manifest rather
// than repeated. The two must agree: the report records the manifest version as
// the provenance of the numbers, while the container tag decides which binaries
// produced them. The `v` prefix matches the git tag that triggers the image
// build (.github/workflows/docker.yml fires on `v*`).
process.container   = { "docker.io/jinlongru/nf-phamseek:v${workflow.manifest.version}" }
apptainer.enabled   = true
apptainer.autoMounts = true

// ---------------------------------------------------------------------------
// Resource ceiling.
//
// A CLOSURE, not a literal map. A literal is evaluated while the config is
// still being parsed, before `profiles{}` runs, so `-profile test` would set
// params.max_cpus = 4 and the ceiling would stay at 16 -- measured, not
// assumed. The closure is evaluated per task, after every profile and
// command-line override has landed.
//
// This replaces the nf-core check_max() helper, which cannot survive Nextflow's
// strict config parser: a config file may declare `def` variables but not `def`
// functions, and the resulting error ("Unexpected input: '('") is reported only
// when the strict parser is actually in use. NXF_SYNTAX_PARSER=v1 in a
// developer's shell hides it completely.
//
// `process.resourceLimits` needs Nextflow 24.04+; the manifest floor is higher
// than that for an unrelated reason (see `nextflowVersion` below).
// ---------------------------------------------------------------------------
process.resourceLimits = { [
    cpus  : params.max_cpus   as int,
    memory: params.max_memory as nextflow.util.MemoryUnit,
    time  : params.max_time   as nextflow.util.Duration
] }

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        cleanup                 = false
        dumpHashes              = true
        nextflow.enable.configProcessNamesValidation = true
    }

    // The default, stated explicitly so `-profile test,apptainer` reads as an
    // instruction rather than an accident.
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        docker.enabled          = false
        podman.enabled          = false
        singularity.enabled     = false
        process.beforeScript    = null
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        apptainer.enabled       = false
        docker.enabled          = false
        podman.enabled          = false
        process.beforeScript    = null
    }
    docker {
        docker.enabled          = true
        // Without this every published file is owned by root, and the person
        // who ran the pipeline cannot delete their own results.
        docker.runOptions       = '-u $(id -u):$(id -g)'
        apptainer.enabled       = false
        podman.enabled          = false
        singularity.enabled     = false
        process.beforeScript    = null
    }
    podman {
        podman.enabled          = true
        apptainer.enabled       = false
        docker.enabled          = false
        singularity.enabled     = false
        process.beforeScript    = null
    }

    // No container: one locked conda environment activated per task.
    //
    // Nextflow has no native pixi support. The obvious `process.pixi` directive
    // was proposed (nextflow-io/nextflow#6157), closed in favour of a general
    // `package` directive (#6342), and that was closed too in February 2026
    // when the effort stalled. Neither shipped, so activation stays in
    // `beforeScript` -- checked again against Nextflow 26.04, not assumed.
    pixi {
        apptainer.enabled       = false
        docker.enabled          = false
        podman.enabled          = false
        singularity.enabled     = false
        process.container       = null
        // Inlined rather than held in a file-level `def`, which the strict
        // config parser rejects. `${projectDir}` resolves at parse time.
        process.beforeScript    = """\
set +u
__PHAMSEEK_HOOK="\$(pixi shell-hook -s bash --no-completions --change-ps1 false --manifest-path '${projectDir}/pixi.toml')" || {
    echo "phamseek: 'pixi shell-hook' failed. Is pixi on PATH, and has 'pixi install' been run in ${projectDir}?" >&2
    exit 1
}
eval "\$__PHAMSEEK_HOOK"
unset __PHAMSEEK_HOOK
set -u
""".stripIndent()
    }

    // Tools already on PATH: a pre-activated shell, an HPC module system, or
    // the offline bundle. Also the cheap way to run `-stub`, which otherwise
    // pulls a 5 GB image in order to run `touch`.
    //
    // Not called `native`: that is a reserved Groovy keyword, and using it as a
    // profile name fails to compile with `Unexpected input: '{'` reported
    // against the `profiles {` line ~40 lines earlier -- a syntax error that
    // points at innocent code.
    nocontainer {
        apptainer.enabled       = false
        docker.enabled          = false
        podman.enabled          = false
        singularity.enabled     = false
        process.container       = null
        process.beforeScript    = null
    }

    slurm {
        process.executor        = 'slurm'
        process.queue           = 'main'
    }
    test { includeConfig 'conf/test.config' }
}

plugins {
    // nf-schema, not nf-validation: the latter is unmaintained and nf-schema is
    // its supported successor. 2.6.0 is the floor -- earlier releases do not
    // register the `validation` config scope with Nextflow's strict config
    // parser, which reports every `validation.*` setting as an unrecognised
    // config option and then ignores it.
    id 'nf-schema@2.6.0'
}

// ---------------------------------------------------------------------------
// A command-line value arrives as a String, and the schema has to say so.
//
// Nextflow 26.04 changed this. Up to 25.10 the launcher converted a
// command-line value to its natural type, so `--min_reads 5` reached the
// pipeline as an Integer and `--skip_host_removal false` as a Boolean. From
// 26.04 -- measured on 26.04.3 and 26.04.6, both parsers of the same release --
// every one of them arrives as a String.
//
// nf-validation papered over this with `validationLenientMode`, which converted
// the String to the declared type before validating. nf-schema's
// `validation.lenientMode` is NOT that: it lets a parameter DECLARED as string
// accept other scalars, which is the opposite direction and does nothing here.
// With it on and `min_reads` declared `integer`, `--min_reads 5` is rejected
// outright -- no numeric or boolean parameter can be set from the command line
// at all. Measured on nf-schema 2.4.2, 2.5.1 and 2.6.0.
//
// So the schema itself declares both forms: `"type": ["integer", "string"]`
// with a `pattern` that only a well-formed number matches. That works under
// both Nextflow generations and needs no lenient mode. Two consequences:
//
//   * The value is STILL a String inside the pipeline. Booleans are therefore
//     read through the asBool() accessors, never through plain Groovy truth --
//     `"false"` is a non-empty string and Groovy calls it true.
//   * `minimum`/`maximum` in JSON Schema apply to a number instance, so they no
//     longer constrain a value that arrives as a String. The one parameter that
//     had a range, --kraken2_confidence, is range-checked in validateMode().
// ---------------------------------------------------------------------------
validation {
    // An unrecognised parameter warns rather than aborts. A typo in an optional
    // flag should not discard a run; the warning names the parameter.
    logging {
        unrecognisedParams = 'warn'
    }

    // The plugin's own help is deliberately OFF.
    //
    // Under Nextflow's strict syntax parser (the default from 26.04) a bare
    // `--help` reaches params as the String "true", not as a Boolean -- measured
    // on 26.04.3. Every nf-schema release reads a String there as "print help
    // for the parameter with this name", so the plugin finds no parameter called
    // "true", prints nothing, and the pipeline runs. That is worse than an
    // error: the user asked for help and got a pipeline run.
    //
    // phamseek therefore renders its own help from this same
    // nextflow_schema.json -- see phamseekHelp() in
    // subworkflows/local/utils_phamseek_pipeline/main.nf. It treats "true" as
    // "print everything" and any other string as a parameter name, so
    // `--help` and `--help kraken2_confidence` both work under either parser.
    help {
        enabled = false
    }
}

// Keep a user's ~/.local Python packages out of the environment, container or
// not: an Apptainer bind of $HOME makes the host's site-packages visible inside
// the image.
env {
    PYTHONNOUSERSITE = 1
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

nextflow.enable.configProcessNamesValidation = false


// Fixed names, overwritten on re-run. The nf-core convention stamps a
// timestamp into each name, which would need one value shared by all four
// scopes -- and the strict config parser allows no top-level `def` to hold it,
// while putting it in `params` prints an internal value in the run header as if
// the user had set it. A re-run into the same --outdir is a re-run of the same
// analysis, so overwriting is what it should do.
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

manifest {
    name            = 'rujinlong/nf-phamseek'
    author          = 'Jinlong Ru'
    homePage        = 'https://github.com/rujinlong/nf-phamseek'
    description     = 'Phage detection in low-biomass clinical Oxford Nanopore metagenomes.'
    mainScript      = 'main.nf'
    // 25.10.0, not the 24.04 that `process.resourceLimits` alone would need:
    // nf-schema 2.6.0 declares `Plugin-Requires: >=25.10.0` and Nextflow refuses
    // to load it below that, with a message about the plugin rather than about
    // the pipeline. Declaring the real floor turns that into one clear error at
    // startup.
    nextflowVersion = '!>=25.10.0'
    version         = '0.2.0'
}
