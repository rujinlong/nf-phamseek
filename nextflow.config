/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    phamseek — Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Software provisioning is handled exclusively by pixi (pixi.toml / pixi.lock).
    There are no per-process containers and no conda directives: one locked
    environment is activated in `beforeScript` for every task.
----------------------------------------------------------------------------------------
*/

params {

    // ------------------------------------------------------------------
    // Input / output
    // ------------------------------------------------------------------
    input                       = null
    outdir                      = 'results'

    // v0.1 implements the `fast` tier only. `full` (assembly, geNomad, CheckV)
    // fails fast with an explicit message rather than running a partial path.
    mode                        = 'fast'

    // ------------------------------------------------------------------
    // Reference databases — always external, never bundled with the repo.
    // `db_dir` supplies the standard layout; the explicit paths below win when
    // set. Resolution happens at initialisation, because a params block cannot
    // reference other params (INV-NF-04).
    // ------------------------------------------------------------------
    db_dir                      = null
    kraken2_db                  = null
    host_index                  = null

    // Declared property of the kraken2 database. It cannot be auto-detected and
    // it changes how the false-positive caveat has to be worded in the report.
    // 'auto' (default) inspects the database's own taxonomy and reports each
    // decoy class separately. 'true'/'false' override that with an operator
    // declaration. A plain false default was actively harmful: the recommended
    // production database *does* carry decoy sequences, nobody remembers the
    // flag, and the report would then print the high-plasmid-false-positive
    // warning for a database where it does not apply.
    db_has_decoy                = 'auto'
    db_label                    = null

    // ------------------------------------------------------------------
    // Step toggles
    // ------------------------------------------------------------------
    skip_host_removal           = false   // skips the level-2 aligner only
    // Bracken's model assumes one fixed read length. ONT reads are variable
    // length, so the assumption is violated by construction -- off by default.
    // Enable it only with bracken_read_length set from your own run.
    skip_bracken                = true

    // ------------------------------------------------------------------
    // Long-read QC (chopper / nanoq)
    // ------------------------------------------------------------------
    chopper_min_quality         = 10
    chopper_min_length          = 200

    // ------------------------------------------------------------------
    // kraken2
    //
    // 0.02 rather than kraken2's default of 0: with a phage reference database
    // the default calls a taxon on a single k-mer hit, which made 61% of human
    // and 38% of clean bacterial contigs look like phage in the benchmark this
    // pipeline is derived from.
    //
    // Do NOT raise it for ONT. Short-read tuning intuition does not transfer:
    // 0.02 -> 0.10 costs ~3.5 points of recall on 150 bp reads at 0.1% error,
    // but 15 points at 95% read identity and 29 points at 87%, because a
    // high-error long read carries far fewer exactly-matching k-mers to vote
    // with. Raising it also cannot remove plasmid/ICE false positives, which
    // are real shared homology rather than stray k-mers.
    // ------------------------------------------------------------------
    kraken2_confidence          = 0.02

    // ------------------------------------------------------------------
    // Host depletion
    // ------------------------------------------------------------------
    host_taxid                  = 9606
    viral_taxid                 = 10239
    // 'all_nonhuman'        — everything not in the host subtree goes to level 2
    // 'nonhuman_nonviral'   — viral-classified reads bypass level 2 (faster,
    //                         but a human read misclassified as viral would
    //                         then escape host depletion)
    l2_input                    = 'all_nonhuman'
    minimap2_preset             = 'map-ont'

    // ------------------------------------------------------------------
    // bracken
    // ------------------------------------------------------------------
    // No safe default exists for ONT. 150 would be a short-read value; set this
    // from the median read length of your run before enabling bracken.
    bracken_read_length         = null
    bracken_level               = 'S'
    bracken_threshold           = 10

    // ------------------------------------------------------------------
    // Reporting thresholds
    // ------------------------------------------------------------------
    min_reads                   = 10
    min_rpm                     = 1.0

    // ------------------------------------------------------------------
    // Generic
    // ------------------------------------------------------------------
    help                        = false
    version                     = false
    monochrome_logs             = false
    validate_params             = true
    validationFailUnrecognisedParams = false
    validationLenientMode            = false
    validationShowHiddenParams       = false

    max_memory                  = '128.GB'
    max_cpus                    = 16
    max_time                    = '240.h'
}

// ---------------------------------------------------------------------------
// pixi activation
//
// One locked environment for the whole pipeline. `pixi shell-hook` emits the
// full activation script (PATH, LD_LIBRARY_PATH, tool-specific variables);
// prepending `.pixi/envs/default/bin` to PATH by hand would miss the latter and
// break native library loading.
//
// INV-NF-03: the process{} block must not read `params.X`, so the manifest path
// is captured in a file-level `def`.
// ---------------------------------------------------------------------------
def pixi_manifest = "${projectDir}/pixi.toml"
def pixi_hook = """\
set +u
__PHAMSEEK_HOOK="\$(pixi shell-hook -s bash --no-completions --change-ps1 false --manifest-path '${pixi_manifest}')" || {
    echo "phamseek: 'pixi shell-hook' failed. Is pixi on PATH, and has 'pixi install' been run in ${projectDir}?" >&2
    exit 1
}
eval "\$__PHAMSEEK_HOOK"
unset __PHAMSEEK_HOOK
set -u
""".stripIndent()

process {
    beforeScript = pixi_hook
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        cleanup                 = false
        dumpHashes              = true
        nextflow.enable.configProcessNamesValidation = true
    }
    // Tools already on PATH (CI, a container image, or a pre-activated shell).
    // Also the quickest way to run `-stub` where the pixi env is not installed.
    no_pixi {
        process.beforeScript    = null
    }
    slurm {
        process.executor        = 'slurm'
        process.queue           = 'main'
    }
    test { includeConfig 'conf/test.config' }
}

plugins {
    id 'nf-validation@1.1.3'
}

// Keep a user's ~/.local Python packages out of the pixi environment.
env {
    PYTHONNOUSERSITE = 1
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

nextflow.enable.configProcessNamesValidation = false

// INV-NF-03: these blocks use file-level defs, not params.X.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
def pipeline_info   = "${params.outdir}/pipeline_info"

timeline {
    enabled = true
    file    = "${pipeline_info}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${pipeline_info}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${pipeline_info}/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${pipeline_info}/pipeline_dag_${trace_timestamp}.html"
}

manifest {
    name            = 'rujinlong/phamseek'
    author          = 'Jinlong Ru'
    homePage        = 'https://github.com/rujinlong/phamseek'
    description     = 'Phage detection in low-biomass clinical Oxford Nanopore metagenomes.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

// INV-NF-05: check_max() is only called from conf/base.config.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
