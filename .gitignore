# --- pixi -------------------------------------------------------------------
# The environment itself is a build artefact (~5 GB); pixi.lock is the source of
# truth and IS committed.
.pixi/

# --- deployment artefacts ---------------------------------------------------
# Offline bundles, packed environments, container images and database archives
# are all multi-GB build outputs. They are shipped out of band, never via git.
dist/
deploy/dist/
*.sif
*.img
*.tar.zst
*.tar.zst.part*
*.tar.gz
phamseek-env.sh
preflight.json

# --- local working notes ----------------------------------------------------
# Rendered by scripts/render_hub.py from the local project context; it embeds
# absolute file:// links to this machine and is not useful to anyone else.
docs/learning-hub/

# State-of-the-delivery notes: open decisions, what was verified, what will bite
# the next person. Deliberately untracked -- it is written for whoever is holding
# this work, not for users, and it goes stale in a way documentation must not.
docs/HANDOFF.md
