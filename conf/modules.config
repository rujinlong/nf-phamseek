/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    phamseek — per-module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    `publishDir` is declared inside each module rather than here, because
    INV-NF-03 forbids reading `params.X` from a config `process{}` block and the
    publication paths are sample-scoped. This file carries only literal extra
    arguments, which a site can override without editing code.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'ONT_QC' {
        // Length and quality thresholds come from params so they appear in
        // --help; anything extra chopper supports can be added here.
        ext.args = ''
    }
}
