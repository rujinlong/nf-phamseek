/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    phamseek — minimal test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Simulated ONT reads shipped in test/ (~6.6 MB), generated with Badread.
    Reference databases are NOT bundled: pass --db_dir for a real run, or add
    -stub to check wiring only.

        nextflow run . -profile test,nocontainer -stub --outdir /tmp/phamseek_stub
        nextflow run . -profile test --db_dir /path/to/phamseek_db --outdir /tmp/phamseek_test

    See test/make_test_data.py for how they were made and what they do and do
    not represent. They exercise wiring, both levels of host depletion and the
    chimera diagnostics, and confirm that a near-neighbour phage is detected.
    They are not a performance benchmark.
----------------------------------------------------------------------------------------
*/

params {

    max_cpus                = 4
    max_memory              = '16.GB'
    max_time                = '2.h'

    input                   = "${projectDir}/test/samplesheet.csv"

    // Badread's nanopore2023 qscore model produces a realistic quality
    // distribution, so the production filter is what these reads meet in
    // practice (~96% pass). Left at the default deliberately: a test profile
    // that relaxes QC stops testing QC.
    chopper_min_quality     = 10
    chopper_min_length      = 200

    // The test sample is tiny; the production reporting floor of 10 reads / 1 RPM
    // would suppress everything.
    min_reads               = 1
    min_rpm                 = 0.0
}
