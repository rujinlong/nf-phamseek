/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    phamseek — minimal test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Simulated ONT reads shipped in test/ (~1.2 MB). Reference databases are NOT
    bundled: pass --db_dir for a real run, or add -stub to check wiring only.

        nextflow run . -profile test,no_pixi -stub --outdir /tmp/phamseek_stub
        nextflow run . -profile test --db_dir /path/to/phamseek_db --outdir /tmp/phamseek_test

    The test reads come from a deliberately simplified simulator (see
    test/make_test_data.py). They exercise wiring and confirm that a
    near-neighbour phage is detected; they are not a performance benchmark.
----------------------------------------------------------------------------------------
*/

params {

    max_cpus                = 4
    max_memory              = '16.GB'
    max_time                = '2.h'

    input                   = "${projectDir}/test/samplesheet.csv"

    // The simulated reads carry a uniform per-read quality of Q12-Q18 and are
    // 1-4 kb, so the production defaults would filter most of them out.
    chopper_min_quality     = 7
    chopper_min_length      = 200

    // The test sample is tiny; the production reporting floor of 10 reads / 1 RPM
    // would suppress everything.
    min_reads               = 1
    min_rpm                 = 0.0
}
