/*
 * phamseek — offline hardening configuration
 * ---------------------------------------------------------------------------
 * Layered on top of the pipeline's own nextflow.config with `-c`, so it wins.
 * Applied automatically by the offline installer's wrapper and by the Apptainer
 * runscript. On an air-gapped machine you want it; on a connected one it costs
 * nothing, because phamseek uses none of the features it switches off.
 *
 * Every entry here closes a path that would otherwise make Nextflow reach the
 * network at run time. The point is not that we enable any of them — it is that
 * a stray profile, a leftover environment variable, or a value inherited from
 * ~/.nextflow/config can enable them without anyone noticing, and the resulting
 * error names a scheduler or a registry rather than the network.
 *
 * Use it explicitly if you are running by hand:
 *     nextflow -c <phamseek>/deploy/offline.config run <pipeline>/main.nf ...
 */

// Software comes from the packed conda prefix that is already on PATH.
// Nothing may solve an environment or pull an image.
conda.enabled       = false
spack.enabled       = false
docker.enabled      = false
podman.enabled      = false
shifter.enabled     = false
charliecloud.enabled = false
apptainer.enabled   = false
singularity.enabled = false

// Seqera platform services. All of them are network round-trips.
wave.enabled        = false
fusion.enabled      = false
tower.enabled       = false

// A remote executor inherited from a user-level config fails by trying to reach
// a scheduler API, which reads as a credentials problem rather than an offline
// one. Pin it: this is a single-workstation deployment.
process.executor    = 'local'

// Nextflow's own update check.
// (NXF_DISABLE_CHECK_LATEST covers the launcher; this covers the report.)
manifest.doi        = null

// Fail fast rather than retrying a network operation until a timeout.
// Genuine compute retries are configured in the pipeline's own base.config.
executor {
    exitReadTimeout = '30 sec'
}
